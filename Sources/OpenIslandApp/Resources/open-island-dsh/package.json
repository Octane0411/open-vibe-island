{
  "name": "open-island-dsh",
  "version": "0.2.0",
  "description": "Session observer, private DSH Web focus relay, and leased human interaction bridge",
  "type": "module",
  "license": "GPL-3.0-only",
  "main": "open-island-dsh.js",
  "exports": {
    ".": "./open-island-dsh.js",
    "./client": "./open-island-dsh-client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "open-island-dsh.js",
    "open-island-dsh-client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
